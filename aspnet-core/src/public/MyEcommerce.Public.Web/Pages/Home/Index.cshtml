@page "/"
@using Microsoft.AspNetCore.Mvc.Localization
@using MyEcommerce.Localization
@using Volo.Abp.Users
@model MyEcommerce.Public.Web.Pages.IndexModel
@inject IHtmlLocalizer<MyEcommerceResource> L
@section styles {
    <abp-style src="/Pages/Home/Index.css" />
}
@section scripts {
    <abp-script src="/Pages/Home/Index.js" />
}
<section class="section-box">
